# Shell scripts and Dockerfiles must keep LF even when checked out on Windows.
# A CRLF shebang makes the kernel look for an interpreter named "/bin/sh\r",
# which fails as "no such file or directory" — and the ATP appendices ZIP is
# built from a working copy, so a CRLF checkout shipped a broken archive.
*.sh text eol=lf
Dockerfile text eol=lf
entrypoint.sh text eol=lf
