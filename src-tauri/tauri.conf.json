{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoreTrace",
  "version": "6.0.0-beta.3",
  "identifier": "fr.coretrace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoreTrace",
        "width": 1440,
        "height": 940,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQkQ2NjRBMkQ4MkIzNjcKUldSbnM0SXRTbWE5UXlERVlOWlpKQnBkenBseDdha2lpQldERm84YWlPckR0WWxSakdaSE9BbUQK",
      "endpoints": [
        "https://github.com/CoreTrace/coretrace-gui/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "resources": ["THIRD_PARTY_NOTICES.txt"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "../assets/ctrace.ico",
      "../assets/ctrace.icns"
    ]
  }
}
