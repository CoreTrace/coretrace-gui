{
  "name": "ctrace-gui",
  "version": "6.0.0-beta.1",
  "private": true,
  "description": "CoreTrace desktop workspace built with Tauri and React",
  "license": "Apache-2.0",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "dist": "tauri build",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "tsc --noEmit",
    "format": "prettier --write desktop vite.config.ts vitest.config.ts",
    "format:check": "prettier --check desktop vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
